#Construct the design matrix
build_star_design <- function(y, p, d, gamma, c) {
  
  n <- length(y)
  start <- max(p, d) + 1L
  
  Z <- matrix(0, nrow = n - start + 1L,
              ncol = 2L * (p + 1L))
  
  for (t in start:n) {
    
    z_t <- y[t - d]
    G <- 1 - exp(-gamma * (z_t - c)^2)
    
    lag_vec <- c(1, y[t - seq_len(p)])
    
    Z[t - start + 1L, ] <- c(lag_vec, lag_vec * G)
  }
  
  Z
}

#Define the loglikelihood
log_likelihood_star <- function(y, phi, sigma2, p, d, gamma, c) {
  
  if (!is.finite(sigma2) || sigma2 <= 0 ||
      !is.finite(gamma) || gamma <= 0 ||
      !is.finite(c) || d < 1 || d > p) {
    return(-Inf)
  }
  
  Z <- build_star_design(y, p, d, gamma, c)
  start <- max(p, d) + 1L
  y_dep <- y[start:length(y)]
  
  if (ncol(Z) != length(phi) ||
      nrow(Z) != length(y_dep)) {
    return(-Inf)
  }
  
  mu <- as.vector(Z %*% phi)
  if (any(!is.finite(mu))) return(-Inf)
  
  resid <- y_dep - mu
  n_eff <- length(y_dep)
  
  -0.5 * n_eff * log(2 * pi * sigma2) -
    sum(resid^2) / (2 * sigma2)
}
#Sample the autogregressive coefficients
sample_phi <- function(y, p, sigma2, d, gamma, c,
                       delta2 = 100) {
  
  Z <- build_star_design(y, p, d, gamma, c)
  start <- max(p, d) + 1L
  y_dep <- y[start:length(y)]
  
  if (!is.finite(sigma2) || sigma2 <= 0 ||
      !is.finite(delta2) || delta2 <= 0) {
    stop("Invalid variance or prior variance.")
  }
  
  V_post <- solve(
    crossprod(Z) / sigma2 +
      diag(1 / delta2, ncol(Z))
  )
  
  mu_post <- V_post %*% crossprod(Z, y_dep) / sigma2
  
  R <- chol(V_post)
  as.vector(mu_post + t(R) %*% rnorm(ncol(Z)))
}
#Sample the error variance
sample_sigma2 <- function(y, phi, p, d, gamma, c,
                          A = 2, B = 0.1) {
  
  Z <- build_star_design(y, p, d, gamma, c)
  start <- max(p, d) + 1L
  y_dep <- y[start:length(y)]
  
  resid <- y_dep - as.vector(Z %*% phi)
  
  shape <- A + length(y_dep) / 2
  rate <- B + sum(resid^2) / 2
  
  1 / rgamma(1, shape = shape, rate = rate)
}
#Sample the d parameter
sample_delay <- function(y, phi, p, sigma2, gamma, c,
                         dmax = p) {
  
  candidates <- seq_len(min(dmax, p))
  log_prob <- vapply(candidates, function(dd) {
    
    ll <- log_likelihood_star(
      y, phi, sigma2, p, dd, gamma, c
    )
    
    ll + log(1 / length(candidates))
    
  }, numeric(1))
  
  if (!any(is.finite(log_prob))) {
    stop("All delay-parameter likelihoods are invalid.")
  }
  
  prob <- exp(log_prob - max(log_prob))
  prob <- prob / sum(prob)
  
  sample(candidates, size = 1, prob = prob)
}
#metropolis update for gamma and c
update_gamma_c <- function(y, phi, sigma2, p, d, gamma, c,
                           sd_log_gamma = 0.05,
                           sd_c = 0.02) {
  
  log_gamma_prop <- rnorm(
    1, mean = log(gamma), sd = sd_log_gamma
  )
  gamma_prop <- exp(log_gamma_prop)
  
  c_prop <- rnorm(1, mean = c, sd = sd_c)
  
  ll_current <- log_likelihood_star(
    y, phi, sigma2, p, d, gamma, c
  )
  
  ll_prop <- log_likelihood_star(
    y, phi, sigma2, p, d, gamma_prop, c_prop
  )
  
  log_prior_gamma_current <- dgamma(
    gamma, shape = 2, rate = 0.1, log = TRUE
  )
  log_prior_gamma_prop <- dgamma(
    gamma_prop, shape = 2, rate = 0.1, log = TRUE
  )
  
  log_prior_c_current <- dnorm(c, 0, 1, log = TRUE)
  log_prior_c_prop <- dnorm(c_prop, 0, 1, log = TRUE)
  
  log_alpha <- (ll_prop - ll_current) +
    (log_prior_gamma_prop - log_prior_gamma_current) +
    (log_prior_c_prop - log_prior_c_current) +
    (log_gamma_prop - log(gamma))
  
  accepted <- is.finite(log_alpha) &&
    log(runif(1)) < min(0, log_alpha)
  
  if (accepted) {
    return(list(
      gamma = gamma_prop,
      c = c_prop,
      accepted = TRUE
    ))
  }
  
  list(
    gamma = gamma,
    c = c,
    accepted = FALSE
  )
}

#Complete Bayesian MCMC algorithm
bayesian_star_mcmc <- function(
    y, n_iter = 20000, p = 2, dmax = 2,
    delta2 = 100, A = 2, B = 0.1,
    init_phi = rep(0, 6),
    init_sigma2 = NULL,
    init_gamma = 20,
    init_c = 0.05,
    init_d = 2) {
  
  if (length(init_phi) != 2 * (p + 1)) {
    stop("init_phi must have length 2*(p+1).")
  }
  
  if (is.null(init_sigma2)) init_sigma2 <- var(y)
  
  sigma2 <- init_sigma2
  phi <- init_phi
  gamma <- init_gamma
  c <- init_c
  d <- init_d
  
  sigma_chain <- numeric(n_iter)
  gamma_chain <- numeric(n_iter)
  c_chain <- numeric(n_iter)
  d_chain <- integer(n_iter)
  phi_chain <- matrix(NA_real_, n_iter, length(phi))
  
  accept_gc <- 0L
  
  for (iter in seq_len(n_iter)) {
    
    phi <- sample_phi(
      y, p, sigma2, d, gamma, c, delta2
    )
    
    sigma2 <- sample_sigma2(
      y, phi, p, d, gamma, c, A, B
    )
    
    d <- sample_delay(
      y, phi, p, sigma2, gamma, c, dmax
    )
    
    gc <- update_gamma_c(
      y, phi, sigma2, p, d, gamma, c
    )
    
    gamma <- gc$gamma
    c <- gc$c
    accept_gc <- accept_gc + as.integer(gc$accepted)
    
    sigma_chain[iter] <- sigma2
    gamma_chain[iter] <- gamma
    c_chain[iter] <- c
    d_chain[iter] <- d
    phi_chain[iter, ] <- phi
    
    if (iter %% 1000 == 0) {
      cat("Iteration:", iter, "of", n_iter, "\n")
    }
  }
  
  list(
    sigma2 = sigma_chain,
    gamma = gamma_chain,
    c = c_chain,
    d = d_chain,
    phi = phi_chain,
    acceptance_rate = accept_gc / n_iter
  )
}

