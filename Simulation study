#Simulate the ESTAR data

set.seed(123)

simulate_series <- function(n, phi, sigma2, gamma, c, d, burn = 500) {
  
  stopifnot(length(phi) == 6, n > 0, sigma2 > 0,
            gamma > 0, d %in% c(1, 2))
  
  total <- n + burn
  y <- numeric(total)
  
  y[1:2] <- rnorm(2, mean = 0, sd = sqrt(sigma2))
  
  for (t in 3:total) {
    
    z_lag <- y[t - d]
    Gt <- 1 - exp(-gamma * (z_lag - c)^2)
    
    mu_t <- phi[1] +
      phi[2] * y[t - 1] +
      phi[3] * y[t - 2] +
      (phi[4] +
         phi[5] * y[t - 1] +
         phi[6] * y[t - 2]) * Gt
    
    y[t] <- mu_t + rnorm(1, sd = sqrt(sigma2))
  }
  
  y[(burn + 1):total]
}

